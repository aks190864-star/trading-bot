import requests
import os

API_KEY = os.getenv("API_KEY")
API_SECRET = os.getenv("API_SECRET")

BOT_TOKEN = os.getenv("TELEGRAM_TOKEN")
CHAT_ID = os.getenv("TELEGRAM_CHAT_ID")


def send_telegram(msg):
    try:
        if not BOT_TOKEN or not CHAT_ID:
            print("Telegram not configured")
            return

        url = f"https://api.telegram.org/bot{BOT_TOKEN}/sendMessage"
        params = {
            "chat_id": CHAT_ID,
            "text": msg
        }

        res = requests.get(url, params=params)
        print("Telegram response:", res.text)

    except Exception as e:
        print("Telegram error:", e)


def get_spot():
    try:
        url = "https://api.delta.exchange/v2/tickers/BTCUSD"
        res = requests.get(url).json()
        return float(res['result']['last_price'])
    except Exception as e:
        print("Spot error:", e)
        return 67000


def get_strikes(spot):
    call = round(spot * 1.07, -2)
    put = round(spot * 0.93, -2)
    return call, put


def run():
    try:
        spot = get_spot()
        print("Current Spot:", spot)

        call, put = get_strikes(spot)

        msg = f"🚀 BOT STARTED\nSpot: {spot}\nSell CALL: {call}\nSell PUT: {put}\nQty: 20"

        print(msg)
        send_telegram(msg)

    except Exception as e:
        print("Main error:", e)


if __name__ == "__main__":
    run()
